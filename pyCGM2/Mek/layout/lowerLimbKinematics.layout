rows: 6
cols: 3

plots:
  - title: Graphique A
    data : LAnkleAngles.0
    position: [0, 0]   # ligne 0, colonne 0
    ylabel: Amplitude
    ylim: [0, 100]

  - title: Graphique B
    data : LAnkleAngles.0
    position: [0, 1]   # ligne 0, colonne 1
    ylabel: Force
    ylim: [-50, 50]

  - title: Graphique C
    data : LAnkleAngles.0
    position: [1, 0]   # ligne 1, colonne 0
    ylabel: Angle
    ylim: [0, 180]

  - title: Graphique D
    data : LAnkleAngles.0
    position: [1, 1]   # ligne 1, colonne 1
    ylabel: Vitesse
    ylim: [-10, 10]
